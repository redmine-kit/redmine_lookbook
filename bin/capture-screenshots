#!/usr/bin/env node
// Captures the images of the documentation (docs/img and docs/img/ja) from a
// running Redmine with Redmine Lookbook and Redmine's test data, with
// headless Chrome. Usage: bin/capture-screenshots [http://127.0.0.1:3000]
// Set CHROME to the Chrome executable if it is not in the default place.
// It needs Node.js 22 or later (fetch and WebSocket) and no packages.
import { spawn } from "node:child_process";
import { mkdirSync, mkdtempSync, rmSync, writeFileSync } from "node:fs";
import { tmpdir } from "node:os";
import { dirname, join } from "node:path";
import { fileURLToPath } from "node:url";

const CHROME = process.env.CHROME ||
  (process.platform === "darwin" ? "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome" : "google-chrome");
const sleep = (ms) => new Promise((r) => setTimeout(r, ms));

async function launch(profileDir, port = 9333) {
  const proc = spawn(CHROME, ["--headless=new", "--disable-gpu", "--hide-scrollbars", `--remote-debugging-port=${port}`,
    `--user-data-dir=${profileDir}`, "--no-first-run", "about:blank"], { stdio: "ignore" });
  for (let i = 0; i < 50; i++) {
    try { await fetch(`http://127.0.0.1:${port}/json/version`); break; } catch { await sleep(200); }
  }
  const target = await (await fetch(`http://127.0.0.1:${port}/json/new?about:blank`, { method: "PUT" })).json();
  const ws = new WebSocket(target.webSocketDebuggerUrl);
  await new Promise((r) => ws.addEventListener("open", r, { once: true }));
  let id = 0; const pending = new Map(); const listeners = [];
  ws.addEventListener("message", (e) => {
    const msg = JSON.parse(e.data);
    if (msg.id && pending.has(msg.id)) { const { resolve, reject } = pending.get(msg.id); pending.delete(msg.id); msg.error ? reject(new Error(JSON.stringify(msg.error))) : resolve(msg.result); }
    else listeners.forEach((l) => l(msg));
  });
  const send = (method, params = {}) => new Promise((resolve, reject) => { const n = ++id; pending.set(n, { resolve, reject }); ws.send(JSON.stringify({ id: n, method, params })); });
  await send("Page.enable"); await send("Runtime.enable");
  const page = {
    send,
    async viewport(width, height, scale = 1) { await send("Emulation.setDeviceMetricsOverride", { width, height, deviceScaleFactor: scale, mobile: false }); },
    async goto(url, wait = 3000) {
      const loaded = new Promise((r) => { const l = (m) => { if (m.method === "Page.loadEventFired") { listeners.splice(listeners.indexOf(l), 1); r(); } }; listeners.push(l); });
      await send("Page.navigate", { url }); await loaded; await sleep(wait);
    },
    async eval(expression, wait = 0) {
      const res = await send("Runtime.evaluate", { expression, awaitPromise: true, returnByValue: true });
      if (res.exceptionDetails) throw new Error(res.exceptionDetails.exception?.description || JSON.stringify(res.exceptionDetails));
      if (wait) await sleep(wait);
      return res.result.value;
    },
    async shot(file, clip) {
      const res = await send("Page.captureScreenshot", { format: "png", ...(clip ? { clip: { ...clip, scale: 1 } } : {}) });
      writeFileSync(file, Buffer.from(res.data, "base64"));
    },
    close() { ws.close(); proc.kill(); },
  };
  return page;
}

const BASE = `${(process.argv[2] || "http://127.0.0.1:3000").replace(/\/$/, "")}${process.env.REDMINE_LOOKBOOK_PATH || "/lookbook"}`;
const out = join(dirname(fileURLToPath(import.meta.url)), "..", "docs", "img");
const profile = mkdtempSync(join(tmpdir(), "redmine-lookbook-chrome-"));
const display = (o) => encodeURIComponent(JSON.stringify({ theme: "", language: "", layout: "none", ...o }));
const preview = (path, o) => `${BASE}/preview/${path}?_display=${display(o)}`;
const inspect = (path, o) => `${BASE}/inspect/${path}?_display=${display(o)}`;

const page = await launch(profile);
try {
async function rectOf(selector, pad = 0) {
  return page.eval(`(() => { const r = document.querySelector(${JSON.stringify(selector)}).getBoundingClientRect();
    return { x: Math.max(0, r.x - ${pad}), y: Math.max(0, r.y - ${pad}), width: r.width + ${pad * 2}, height: r.height + ${pad * 2} }; })()`);
}

for (const lang of ["en", "ja"]) {
  const dir = lang === "en" ? out : `${out}/ja`;
  mkdirSync(dir, { recursive: true });
  const language = lang === "en" ? "" : "ja";

  // The Lookbook screen with a page preview and the navigation open
  await page.viewport(1440, 900);
  await page.goto(inspect("pages/projects/overview", { language, layout: "page" }), 4000);
  await page.eval(`(() => {
    for (const key of ["previews-nav-pages-action", "previews-nav-pages-projects-action", "previews-nav-components-action"]) {
      document.querySelector('button[key="' + key + '"]')?.click();
    }
    document.querySelector('#hide-drawer-button')?.click();
  })()`, 2500);
  await page.shot(`${dir}/lookbook.png`);

  // The toolbar's display options
  await page.eval(`document.querySelector('#display-options-dropdown-button').click()`, 1200);
  const menu = await page.eval(`(() => {
    const b = document.querySelector('#display-options-dropdown-button').getBoundingClientRect();
    const boxes = [...document.querySelectorAll('.tippy-box, [data-tippy-root]')].map((e) => e.getBoundingClientRect()).filter((r) => r.width > 0);
    const left = Math.min(b.left, ...boxes.map((r) => r.left)) - 16, right = Math.max(b.right, ...boxes.map((r) => r.right)) + 16;
    const bottom = Math.max(b.bottom, ...boxes.map((r) => r.bottom)) + 16;
    return { x: Math.max(0, left), y: Math.max(0, b.top - 12), width: Math.min(window.innerWidth, right) - Math.max(0, left), height: bottom - b.top + 12 }; })()`);
  await page.shot(`${dir}/toolbar.png`, menu);

  // The same page with Redmine's themes
  await page.viewport(1200, 720);
  for (const theme of ["", "alternate", "classic"]) {
    await page.goto(preview("pages/issues/show", { language, layout: "page", theme }), 2500);
    await page.shot(`${dir}/theme-${theme || "default"}.png`);
  }

  // A narrow screen with the flyout menu open
  await page.viewport(390, 760);
  await page.goto(preview("components/layout/whole_flyout_open", { language }), 3000);
  await page.shot(`${dir}/narrow.png`);

}

// Right-to-left (the same image for both languages)
await page.viewport(1200, 720);
await page.goto(preview("pages/issues/show", { language: "ar", layout: "page" }), 2500);
await page.shot(`${out}/rtl.png`);

// Wiki formatting (the sample text is in English)
await page.viewport(1200, 900);
await page.goto(preview("components/content/wiki", {}), 3000);
await page.shot(`${out}/wiki.png`);

console.log(`Saved the images in ${out}`);
} finally {
  page.close();
  rmSync(profile, { recursive: true, force: true });
}
