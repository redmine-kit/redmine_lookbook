#!/usr/bin/env bash
# The plugin as a gem (docs/installation.md, "An existing Redmine"), in Apple
# container when it runs, else in Docker (CONTAINER_CLI=container|docker
# chooses). In the image of bin/test (Redmine 7.0.3, without Lookbook, as on a
# production server), it builds the gem from this checkout, installs it, takes
# the plugin out of plugins/ and adds the gem to Gemfile.local, then migrates
# and boots Redmine through zeitwerk:check and in the production environment,
# which loads every file at start-up (eager_load). It fails when the gem misses
# a file that the checkout has, or when Redmine doesn't take the plugin from the
# gem's folder (its directory, code and rake tasks). Then once more with the
# checkout back in plugins/ and the gem still in Gemfile.local: the checkout
# wins.
#   bin/test-gem
# Commands that run inside the container are in single quotes on purpose.
# shellcheck disable=SC2016
set -euo pipefail
cd "$(dirname "$0")/.."
plugin=redmine_kit_lookbook
name=redmine-kit-lookbook-test
image=$name
# A path of the plugin's routes (config/routes.rb), which Redmine must route to
# the plugin; empty when the plugin has no routes. Lookbook's route is drawn
# only while the plugin is on, never in production.
route=
source bin/test_slot
source bin/container_cli
bin/services >/dev/null
source bin/test_image

# The checks, in Ruby, run by `bin/rails runner` in the production environment.
# $1: where the plugin must come from (gem or plugins).
check='
  expected, plugin_id, route = ARGV
  plugin = Redmine::Plugin.find(plugin_id)
  dir = File.realpath(plugin.directory)
  from = dir.start_with?(File.realpath(Gem.dir)) ? "gem" : "plugins"
  abort "#{plugin_id} is from #{from} (#{dir}), not #{expected}" unless from == expected
  abort "not eager loaded" unless Rails.application.config.eager_load
  namespace = "RedmineKit::#{plugin_id.delete_prefix("redmine_kit_").camelize}".constantize
  abort "#{namespace}::VERSION is not the plugin version" unless namespace::VERSION == plugin.version
  if File.directory?(File.join(dir, "assets"))
    abort "no asset paths" if plugin.asset_paths.blank?
  end
  unless plugin.latest_migration.nil? || Redmine::Plugin::Migrator.current_version(plugin) == plugin.latest_migration
    abort "not migrated"
  end
  if route.present?
    controller = Rails.application.routes.recognize_path(route)[:controller].to_s
    unless File.file?(File.join(dir, "app/controllers/#{controller}_controller.rb"))
      abort "#{route} is not routed to a controller of the plugin (#{controller})"
    end
  end
  puts "#{plugin_id} #{plugin.version} from #{from}: #{dir}"'
# A database of this run's own, dropped at the end.
"$cli" run --rm --network "$network" ${opts[@]+"${opts[@]}"} -e TEST_DATABASE="redmine_test_$$" \
  -e PLUGIN="$plugin" -e ROUTE="$route" -e CHECK="$check" "$image" sh -ec '
  (cd "plugins/$PLUGIN" && gem build --quiet "$PLUGIN.gemspec" --output "/tmp/$PLUGIN.gem")
  mv "plugins/$PLUGIN" /tmp/checkout
  gem install --local --no-document --quiet "/tmp/$PLUGIN.gem"
  printf "%s\n" "production:" "  adapter: postgresql" "  host: ${TEST_DATABASE_HOST:-postgres}" "  database: $TEST_DATABASE" \
    "  username: postgres" >> config/database.yml
  printf "%s\n" "gem '\''$PLUGIN'\''" "gem '\''simplecov-cobertura'\'', '\''3.2.0'\'', group: :test" > Gemfile.local
  bundle install --prefer-local --quiet
  for from in gem plugins; do
    echo "== $from"
    # The checkout back in plugins/, with its Gemfile (Lookbook in the
    # development group, which the image leaves out), as after installing it.
    if [ "$from" = plugins ]; then mv /tmp/checkout "plugins/$PLUGIN" && bundle install --prefer-local --quiet; fi
    # A new database each time: without the schema the last migration dumped,
    # which db:migrate would load into the empty database, with the plugin tables.
    rm -f db/schema.rb
    bin/rails db:drop db:create db:migrate redmine:plugins:migrate >/dev/null
    bin/rails zeitwerk:check
    RAILS_ENV=production SECRET_KEY_BASE=test-gem bin/rails runner "$CHECK" "$from" "$PLUGIN" "$ROUTE"
    # The plugin's rake tasks (lib/tasks), which boot/ loads for the gem.
    bin/rails -T redmine_kit:lookbook | grep -q "redmine_kit:lookbook:load_test_data" ||
      { echo "no rake tasks of $PLUGIN" >&2; exit 1; }
  done
  bin/rails db:drop >/dev/null'
