<!DOCTYPE html>
<html lang="<%= current_language %>" dir="<%= l(:direction) %>">
<head>
<meta charset="utf-8" />
<title><%= html_title %></title>
<meta name="viewport" content="width=device-width, initial-scale=1">
<%= csrf_meta_tag %>
<%= stylesheet_link_tag 'jquery/jquery-ui-1.13.2', 'tribute-5.1.3', 'application', 'dropdown', 'responsive', :media => 'all' %>
<%= javascript_importmap_tags %>
<%= javascript_heads %>
<%= heads_for_theme %>
<%= heads_for_i18n %>
<%= yield :header_tags -%>
</head>
<body class="<%= body_css_classes %>" data-text-formatting="<%= Setting.text_formatting %>">
<div id="wrapper">
  <div id="main" class="nosidebar">
    <div id="content">
      <%= yield %>
    </div>
  </div>
</div>
</body>
</html>
