<% resolved = path || path_block&.call %>
<% if resolved %>
<%= raw RedmineLookbook::PageRenderer.new(controller).render(resolved, user: user) %>
<% else %>
<!DOCTYPE html>
<html><body><p>Load Redmine's test data first: <code>bin/rails redmine_lookbook:load_test_data CONFIRM=yes</code></p></body></html>
<% end %>
