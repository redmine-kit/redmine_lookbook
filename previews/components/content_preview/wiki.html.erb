<% issue = Issue.joins(:attachments).where(attachments: { filename: 'picture.jpg' }).order(:id).first || RedmineKit::Lookbook::TestData.issue %>
<%# Some macros (child_pages, recent_pages) read @project. %>
<% @project = issue&.project %>
<div class="wiki">
<%= RedmineKit::Lookbook::TextFormatting.with(format) {
      textilizable(RedmineKit::Lookbook::TextFormatting.sample(format), object: issue, project: issue&.project, headings: true)
    } %>
</div>
