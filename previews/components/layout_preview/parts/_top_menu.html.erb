<%# The top menu of Redmine's base layout. open: show the account menu. %>
<% open = local_assigns.fetch(:open, false) %>
<nav class="top-menu" id="top-menu">
  <div class="general-menu">
    <div class="top-menu__links">
      <%= render_menu :top_menu if User.current.logged? || !Setting.login_required? -%>
    </div>
  </div>
  <div class="profile-menu">
    <% if User.current.logged? %>
      <div id="account" class="dropdown" data-controller="dropdown">
        <a href="#" class="dropdown-trigger" data-action="click->dropdown#toggle">
          <%= avatar(User.current, size: "22") %>
          <%= sprite_icon("angle-down", size: 14) %>
        </a>
        <div class="dropdown-content<%= ' hidden' unless open %>" data-dropdown-target="content">
          <div class="user-info">
            <span class="user-name"><%= User.current.name %></span>
            <span class="user-login"><%= "@#{User.current.login}" %></span>
          </div>
          <div class="dropdown-divider"></div>
          <%= render_menu :account_menu -%>
        </div>
      </div>
    <% else %>
      <div id="account" class="top-menu__links">
        <%= render_menu :account_menu -%>
      </div>
    <% end %>
  </div>
</nav>
