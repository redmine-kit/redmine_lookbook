<h2><%= l(:label_issue_new) %></h2>
<div class="box tabular">
  <p><label for="lookbook_subject"><%= l(:field_subject) %> <span class="required">*</span></label><%= text_field_tag 'subject', 'Example subject', id: 'lookbook_subject', size: 60 %></p>
  <p><label for="lookbook_status"><%= l(:field_status) %></label><%= select_tag 'status', options_from_collection_for_select(IssueStatus.sorted, :id, :name), id: 'lookbook_status' %></p>
  <p><label for="lookbook_due_date"><%= l(:field_due_date) %></label><%= date_field_tag 'due_date', Date.today, id: 'lookbook_due_date', size: 10 %></p>
  <p><label for="lookbook_private"><%= l(:field_is_private) %></label><%= check_box_tag 'private', '1', true, id: 'lookbook_private' %></p>
  <p><label for="lookbook_description"><%= l(:field_description) %></label><%= text_area_tag 'description', "Some *bold* text.", id: 'lookbook_description', rows: 5, class: 'wiki-edit' %></p>
</div>
<p><%= submit_tag l(:button_create) %> <%= submit_tag l(:button_create_and_continue) %></p>
